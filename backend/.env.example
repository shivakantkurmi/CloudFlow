# ==========================================
# CloudFlow Backend Environment Variables
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration (PostgreSQL via Prisma)
# Replace USER, PASSWORD, HOST, PORT, and DATABASE with your actual credentials
DATABASE_URL="postgresql://postgres:your_password_here@localhost:5432/cloudflow?schema=public"

# JWT Authentication Secrets
# You can generate strong keys using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET="generate-a-secure-random-string-for-access-key-here"
JWT_REFRESH_SECRET="generate-a-secure-random-string-for-refresh-key-here"

# JWT Expirations
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Rate Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX=100           # maximum requests per window

# Keep-Alive / Anti-Sleep Configuration
# Set to 'false' to disable background pings. Default is 'true'.
KEEP_ALIVE_ENABLED=true
# Ping interval in minutes (default: 10, recommended <= 14 for Render/Supabase)
KEEP_ALIVE_INTERVAL_MINUTES=10
# Optional: Public URL of your deployed backend to self-ping over HTTP (prevents Render spin-down)
# (If deployed on Render, RENDER_EXTERNAL_URL is automatically detected if this is unset)
# KEEP_ALIVE_URL="https://your-cloudflow-api.onrender.com/health"

